<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Wraithcairn</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Windows .exe icon (icons/icon.ico, transparent corners) -->
    <ApplicationIcon>icons/icon.ico</ApplicationIcon>
    <Product>wraithcairn</Product>
    <!-- Local builds report 0.0.0-dev; the release workflow passes
         -p:Version / -p:InformationalVersion from GitVersion. -->
    <Version>0.0.0</Version>
    <InformationalVersion>0.0.0-dev</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <!-- LibraryImport (X11 window hints in LinuxWindowIdentity.cs) -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- Window/taskbar icon loaded at runtime via avares://, plus the sizes
         DesktopIntegration installs into ~/.local/share/icons on Linux.
         icons/ = assets/icon-*.png with transparent rounded corners
         (scripts/make-transparent-icons.py); assets/ stays as delivered. -->
    <AvaloniaResource Include="icons/icon-*.png" Link="assets/%(Filename)%(Extension)" />
    <!-- Same PNGs as plain manifest resources, so the install-desktop flag can
         write them without starting Avalonia (no display needed, e.g. from
         the install script over SSH). -->
    <EmbeddedResource Include="icons/icon-*.png" LogicalName="icons/%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="12.1.6" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.6" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.6" />
    <!-- Native Wayland backend, opt-in via WRAITHCAIRN_WAYLAND=1 (Program.cs) -->
    <PackageReference Include="Avalonia.Wayland" Version="12.1.6" />

    <!-- Terminal control, pane layout helpers, services -->
    <PackageReference Include="RoyalApps.RoyalTerminal.Avalonia" Version="0.7.2" />
    <!-- Native Ghostty VT engine + preference-based factory -->
    <PackageReference Include="RoyalApps.RoyalTerminal.Terminal.Vt.Ghostty" Version="0.7.2" />
    <PackageReference Include="RoyalApps.RoyalTerminal.Terminal.Vt.Default" Version="0.7.2" />
    <PackageReference Include="RoyalApps.RoyalTerminal.Terminal.Pty.Platform" Version="0.7.2" />
    <!-- Prebuilt libghostty-vt native assets per OS -->
    <PackageReference Include="RoyalApps.RoyalTerminal.GhosttySharp.Native.Linux64" Version="0.7.2" />
    <PackageReference Include="RoyalApps.RoyalTerminal.GhosttySharp.Native.Win64" Version="0.7.2" />
    <PackageReference Include="RoyalApps.RoyalTerminal.GhosttySharp.Native.OSX" Version="0.7.2" />
  </ItemGroup>

  <!--
    Single-file publish: the SDK drops libSystem.Native from the bundle
    because the host links it statically. But the host does not export those
    symbols, and RoyalTerminal's Unix PTY poller P/Invokes "System.Native"
    directly, so it would fail with DllNotFoundException. Keep the real
    shared library in the bundle; it is extracted with the other native libs
    (IncludeNativeLibrariesForSelfExtract) and found by normal probing.
  -->
  <Target Name="KeepSystemNativeInSingleFile"
          AfterTargets="ComputeResolvedFilesToPublishList"
          BeforeTargets="_ComputeFilesToBundle;GenerateSingleFileBundle"
          Condition="'$(PublishSingleFile)' == 'true'">
    <ItemGroup>
      <_WcSystemNative Include="@(RuntimePackAsset)"
                       Condition="'%(Filename)' == 'libSystem.Native'" />
      <ResolvedFileToPublish Include="@(_WcSystemNative)"
                             Exclude="@(ResolvedFileToPublish)">
        <RelativePath>%(Filename)%(Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        <AssetType>native</AssetType>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

</Project>
